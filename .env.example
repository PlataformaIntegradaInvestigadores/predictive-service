# Copiar este archivo como ".env" y ajustar los valores según el entorno.

# Ruta dentro del contenedor donde estarán los CSV requeridos por el GRS:
# articulos_ecuador_CLEAN.csv, autor_articulo_CLEAN.csv, topic_article_CLEAN.csv
CENTINELA_DATA_PATH=/app/data

# Orígenes permitidos por CORS (lista de URLs separadas por coma)
BACKEND_CORS_ORIGINS=["https://centinela.epn.edu.ec"]

# Períodos usados por el GRS para identificar grupos persistentes de autores
GRS_PERIOD1_START=2020
GRS_PERIOD1_END=2022
GRS_PERIOD2_START=2023
GRS_PERIOD2_END=2025
